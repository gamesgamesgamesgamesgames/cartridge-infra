{{ happyview_hostname }} {
    handle {{ happyview_base_path | default('/hv') }} {
        redir {{ happyview_base_path | default('/hv') }}/ permanent
    }
    handle {{ happyview_base_path | default('/hv') }}/ {
        reverse_proxy happyview:3000
    }
    handle {{ happyview_base_path | default('/hv') }}/* {
        reverse_proxy happyview:3000
    }
    handle /xrpc/* {
        rewrite * {{ happyview_base_path | default('/hv') }}{uri}
        reverse_proxy happyview:3000
    }
    handle /oauth/* {
        rewrite * {{ happyview_base_path | default('/hv') }}{uri}
        reverse_proxy happyview:3000
    }

    handle {
        reverse_proxy docs:3001
    }
}

{{ cartridge_api_hostname }} {
    reverse_proxy happyview:3000
}

# Public analytics ingest. Only entry point to the colocated ClickHouse; the
# INSERT-only `ingest` user's password gates writes.
{{ clickhouse_ingest_domain | default('ch.kart.sh') }} {
    reverse_proxy clickhouse:8123
}
