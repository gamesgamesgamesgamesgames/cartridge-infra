{
    email {{ kart_pds_contact_email }}
}

# Wildcard cert for the whole kart.sh zone via Cloudflare DNS-01.
# Covers:
#   - {{ kart_pds_hostname }} (the PDS service hostname)
#   - *.{{ kart_pds_handle_domain }} (user handle subdomains like trezy.kart.sh)
# One cert, DNS-01 challenge, no per-subdomain issuance.
*.{{ kart_pds_handle_domain }}, {{ kart_pds_hostname }} {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    log {
        output stdout
        format json
    }

    # pretend age assurance records exist
    @ageassurance {
        host {{ kart_pds_hostname }}
        path /xrpc/app.bsky.ageassurance.getState
    }
    handle @ageassurance {
        header content-type "application/json"
        header access-control-allow-headers "authorization,dpop,atproto-accept-labelers,atproto-proxy"
        header access-control-allow-origin "*"
        respond `{"state":{"lastInitiatedAt":"2025-07-14T14:22:43.912Z","status":"assured","access":"full"},"metadata":{"accountCreatedAt":"2022-11-17T00:35:16.391Z"}}` 200
    }

    handle {
        reverse_proxy http://tranquil-pds:3000
    }
}
