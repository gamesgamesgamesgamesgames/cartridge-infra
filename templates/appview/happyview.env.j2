DATABASE_URL=postgres://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}
PUBLIC_URL={{ happyview_public_url }}
SESSION_SECRET={{ happyview_session_secret }}
JETSTREAM_URL={{ happyview_jetstream_url }}
RELAY_URL={{ happyview_relay_url }}
EVENT_LOG_RETENTION_DAYS={{ happyview_event_log_retention_days }}
# HappyView defaults to happyview=debug,tower_http=debug, which logs every
# request and filled the disk in Nov 2026.
RUST_LOG={{ happyview_rust_log | default('happyview=info,tower_http=info,sqlx=warn') }}
{% if happyview_allow_private_hosts | default('') %}
# HappyView 2.17+ refuses script and plugin requests to private addresses
# unless the host is listed here (host:port, comma-separated). Cartridge's
# scripts call Meilisearch on the private network and ClickHouse on the
# cartridge_shared docker network.
ALLOW_PRIVATE_HOSTS={{ happyview_allow_private_hosts }}
{% endif %}
{% if happyview_token_encryption_key is defined and happyview_token_encryption_key %}
TOKEN_ENCRYPTION_KEY={{ happyview_token_encryption_key }}
{% endif %}

