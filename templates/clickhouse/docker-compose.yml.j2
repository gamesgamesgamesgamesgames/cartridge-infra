# Rotate every container's json-file log so no single container can fill the
# disk (the appview's HappyView log reached 32 GB in Nov 2026).
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "{{ docker_log_max_size | default('50m') }}"
    max-file: "{{ docker_log_max_file | default('5') }}"

services:
  clickhouse:
    logging: *default-logging
    container_name: clickhouse
    image: "clickhouse/clickhouse-server:{{ clickhouse_image_tag }}"
    restart: unless-stopped
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - "{{ clickhouse_data_dir }}/data:/var/lib/clickhouse"
      - "{{ clickhouse_data_dir }}/config/config.d:/etc/clickhouse-server/config.d:ro"
      - "{{ clickhouse_data_dir }}/config/users.d:/etc/clickhouse-server/users.d:ro"
    expose:
      - "8123"
      - "9000"
    ports:
      - "127.0.0.1:8123:8123"
    networks:
      - cartridge_shared
    deploy:
      resources:
        limits:
          memory: "{{ clickhouse_mem_limit }}"
        reservations:
          memory: 512M

networks:
  cartridge_shared:
    external: true
