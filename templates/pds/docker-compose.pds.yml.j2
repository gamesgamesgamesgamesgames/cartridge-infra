# Rotate every container's json-file log so no single container can fill the
# disk (the appview's HappyView log reached 32 GB in Nov 2026).
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "{{ docker_log_max_size | default('50m') }}"
    max-file: "{{ docker_log_max_file | default('5') }}"

services:
  pds:
    logging: *default-logging
    container_name: pds
    image: ghcr.io/bluesky-social/pds:{{ pds_image_tag }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - type: bind
        source: {{ pds_data_dir }}
        target: {{ pds_data_dir }}
    env_file:
      - {{ pds_data_dir }}/pds.env

  caddy:
    logging: *default-logging
    container_name: caddy
    image: caddy:2
    network_mode: host
    restart: unless-stopped
    volumes:
      - type: bind
        source: {{ pds_data_dir }}/caddy/data
        target: /data
      - type: bind
        source: {{ pds_data_dir }}/caddy/etc/caddy
        target: /etc/caddy
