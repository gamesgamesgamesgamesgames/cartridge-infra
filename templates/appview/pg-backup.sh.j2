#!/bin/bash
set -euo pipefail

BACKUP_DIR="{{ pg_backup_dir }}"
RETENTION_DAYS="{{ pg_backup_retention_days }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/happyview_${TIMESTAMP}.sql.gz"

# Fail loudly rather than create the directory: a wrong path (it was rendered
# as a missing /opt/happyview/backups from Jun 13 to Nov 2026) would otherwise
# write dumps onto the root disk. The playbooks create the real directory.
if [[ ! -d "${BACKUP_DIR}" ]]; then
  echo "pg-backup: backup directory ${BACKUP_DIR} does not exist; check pg_backup_dir" >&2
  exit 1
fi

# Dump via the running postgres container
docker exec postgres pg_dump -U {{ postgres_user }} {{ postgres_db }} | gzip > "${BACKUP_FILE}"

# Remove backups older than retention period
find "${BACKUP_DIR}" -name "happyview_*.sql.gz" -mtime +${RETENTION_DAYS} -delete

echo "Backup complete: ${BACKUP_FILE}"
